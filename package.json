{
  "name": "pixel-survivor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "vite build",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "test:e2e": "node scripts/e2e.mjs",
    "test:e2e:production": "node scripts/e2e.mjs --preview",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "phaser": "4.2.1",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "22.15.30",
    "@vitejs/plugin-vue": "6.0.10",
    "eslint": "10.14.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "7.3.7",
    "vitest": "5.0.5",
    "vue-tsc": "3.1.1",
    "eslint-plugin-vue": "10.12.0",
    "vue-eslint-parser": "10.4.1"
  }
}
